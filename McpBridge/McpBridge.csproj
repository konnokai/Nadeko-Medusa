<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>

		<!-- Reduces some boilerplate in your .cs files -->
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- 相依組件一律由 bot 提供，理由見 RemindInstantNoodles.csproj。
		     這個外掛特別不能帶自己的 System.Text.Json：IAiTool.ParameterSchema 的 JsonElement 必須是 bot 那一版的型別。 -->
		<EnableDynamicLoading>false</EnableDynamicLoading>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Discord.Net" Version="3.19.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.1" />
		<PackageReference Include="Serilog" Version="4.2.0" />
		<ProjectReference Include="..\nadekobot\src\NadekoBot\NadekoBot.csproj" ReferenceOutputAssembly="False" Configuration="Release">
			<PrivateAssets>all</PrivateAssets>
			<!-- 只拿來觸發 bot 建置與取得編譯參考，不把 bot 的輸出與 data/、Migrations/ 內容複製過來 -->
			<Private>false</Private>
		</ProjectReference>
		<Reference Include="Nadeko.Medusa">
			<HintPath>..\nadekobot\src\Nadeko.Medusa\bin\Release\net9.0\Nadeko.Medusa.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NadekoBot">
			<HintPath>..\nadekobot\src\NadekoBot\bin\Release\net9.0\NadekoBot.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\McpGateway\Contracts.cs" Link="Contracts.cs" />
	</ItemGroup>

	<!-- Copy shortcut and full strings to output (if they exist) -->
	<ItemGroup>
		<None Update="res.yml;strings/**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
