<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>

		<!-- Reduces some boilerplate in your .cs files -->
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Medusa 以 AssemblyLoadContext 載入本專案，相依組件一律由 bot 提供（找不到就回退到 bot
		     已載入的版本，型別必須共用，否則注入 bot 的服務會型別不合）。
		     因此關閉 EnableDynamicLoading，避免把 bot 已有的 80+ 個組件複製進輸出；
		     deps.json／runtimeconfig.json 是本專案自己的檔案，保留不影響載入（`dotnet ef` 也會用到）。 -->
		<EnableDynamicLoading>false</EnableDynamicLoading>
	</PropertyGroup>
	<ItemGroup>
		<!-- 不知道為啥吃不到 Nadeko 自身專案的套件引用，另外拉需求出來  -->
		<PackageReference Include="OneOf" Version="3.0.271" />
		<PackageReference Include="OneOf.SourceGenerator" Version="3.0.271" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.1" />
		<PackageReference Include="Discord.Net" Version="3.19.0" />
		<PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
		<PackageReference Include="SixLabors.Shapes" Version="1.0.0-beta0009" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog" Version="4.2.0" />
	</ItemGroup>


	<ItemGroup>
		<Reference Include="Nadeko.Medusa">
			<HintPath>..\nadekobot\src\Nadeko.Medusa\bin\Release\net9.0\Nadeko.Medusa.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NadekoBot">
			<HintPath>..\nadekobot\src\NadekoBot\bin\Release\net9.0\NadekoBot.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Copy shortcut and full strings to output (if they exist) -->
	<ItemGroup>
		<None Update="res.yml;strings/**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
